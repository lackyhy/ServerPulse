# ===================================================================
#  Пример конфигурации параметров Server Pulse (config.yaml.example)
#  Скопируйте этот файл в config.yaml:
#    cp config.yaml.example config.yaml
# ===================================================================

# Порт веб-интерфейса дашборда и REST API
port: 3000

# Хост привязки веб-сервера (0.0.0.0 — доступен по локальной сети, 127.0.0.1 — только с этого ПК)
host: '0.0.0.0'

# Пароль для доступа к веб-панели и REST API
# Если указан — при входе в панель запрашивается пароль, а без него все API возвращают 403 Forbidden.
# Если оставить пустым ('') или закомментировать — доступ открыт без пароля.
password: ''

# Путь к файлу со списком серверов для мониторинга
servers_file: 'servers.yaml'

# Настройки SSH-подключения к серверам
ssh:
  # Путь к приватному ключу SSH (по умолчанию id_ed25519)
  key_path: '~/.ssh/id_ed25519'
  # Пользователь по умолчанию для SSH
  user: 'root'
  # Таймаут выполнения SSH команд (в секундах)
  timeout_seconds: 6
  # Интервал фонового опроса метрик серверов (ЦП, ОЗУ, Swap, Диск, Сеть, Docker, tmux, Порты)
  poll_interval_seconds: 15
